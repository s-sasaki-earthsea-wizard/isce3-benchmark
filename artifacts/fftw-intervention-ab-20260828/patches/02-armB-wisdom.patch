diff --git a/cxx/isce3/matchtemplate/pycuampcor/cuFftwPlanProbe.h b/cxx/isce3/matchtemplate/pycuampcor/cuFftwPlanProbe.h
index a5024029b..4cb079a9f 100644
--- a/cxx/isce3/matchtemplate/pycuampcor/cuFftwPlanProbe.h
+++ b/cxx/isce3/matchtemplate/pycuampcor/cuFftwPlanProbe.h
@@ -25,6 +25,27 @@
 //       its sha256 is the run's "plan hash".
 namespace isce3::matchtemplate::pycuampcor {
 
+// Arm B: planner flag selection with optional wisdom pinning.
+//   PYCUAMPCOR_FFTW_WISDOM_IMPORT=<path>
+//       Import wisdom from <path> once per process and plan with
+//       FFTW_WISDOM_ONLY, so a missing or non-matching wisdom yields a
+//       NULL plan (caught fail-closed in probedPlan) instead of silently
+//       re-measuring. Unset: stock FFTW_MEASURE.
+inline unsigned planFlags()
+{
+    static const unsigned flags = []() -> unsigned {
+        const char* path = std::getenv("PYCUAMPCOR_FFTW_WISDOM_IMPORT");
+        if (path == nullptr)
+            return FFTW_MEASURE;
+        if (fftwf_import_wisdom_from_filename(path) == 0) {
+            throw std::runtime_error(
+                    std::string("FFTW wisdom import failed: ") + path);
+        }
+        return FFTW_MEASURE | FFTW_WISDOM_ONLY;
+    }();
+    return flags;
+}
+
 template<typename PlanFn>
 fftwf_plan probedPlan(const char* site, PlanFn&& makePlan)
 {
