diff --git a/cxx/isce3/matchtemplate/pycuampcor/cuFftwPlanProbe.h b/cxx/isce3/matchtemplate/pycuampcor/cuFftwPlanProbe.h
new file mode 100644
index 000000000..a5024029b
--- /dev/null
+++ b/cxx/isce3/matchtemplate/pycuampcor/cuFftwPlanProbe.h
@@ -0,0 +1,57 @@
+#pragma once
+
+#include <fftw3.h>
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <stdexcept>
+#include <string>
+
+// Observation probe for the FFTW planner intervention A/B
+// (s-sasaki-earthsea-wizard/isce3-benchmark#48). Applied identically to
+// every arm, including the control, so that the arms differ only in the
+// planner flags passed at the seven fftwf_plan_* call sites.
+//
+// Environment variables (all optional; with none set the only behavioral
+// change vs stock is a NULL-plan check that FFTW_MEASURE / FFTW_ESTIMATE
+// planning is not expected to trigger):
+//   PYCUAMPCOR_FFTW_LOG=1
+//       Print one line per planner call to stderr: site name, wall-clock
+//       seconds spent inside the planner.
+//   PYCUAMPCOR_FFTW_WISDOM_EXPORT=<path>
+//       After each planner call, export the process's accumulated wisdom
+//       to <path>. The final write therefore holds every plan of the run;
+//       its sha256 is the run's "plan hash".
+namespace isce3::matchtemplate::pycuampcor {
+
+template<typename PlanFn>
+fftwf_plan probedPlan(const char* site, PlanFn&& makePlan)
+{
+    const auto t0 = std::chrono::steady_clock::now();
+    fftwf_plan plan = makePlan();
+    const auto t1 = std::chrono::steady_clock::now();
+    if (std::getenv("PYCUAMPCOR_FFTW_LOG") != nullptr) {
+        std::fprintf(stderr,
+                "[pycuampcor-fftw] site=%s plan_seconds=%.6f plan_null=%d\n",
+                site, std::chrono::duration<double>(t1 - t0).count(),
+                plan == nullptr ? 1 : 0);
+        std::fflush(stderr);
+    }
+    if (const char* path = std::getenv("PYCUAMPCOR_FFTW_WISDOM_EXPORT")) {
+        if (fftwf_export_wisdom_to_filename(path) == 0) {
+            throw std::runtime_error(
+                    std::string("FFTW wisdom export failed: ") + path);
+        }
+    }
+    if (plan == nullptr) {
+        // Fail closed: never let a NULL plan reach fftwf_execute. In
+        // practice reachable only under FFTW_WISDOM_ONLY (arm B) when no
+        // applicable wisdom exists for a requested transform.
+        throw std::runtime_error(
+                std::string("FFTW planner returned NULL at site ") + site);
+    }
+    return plan;
+}
+
+} // namespace isce3::matchtemplate::pycuampcor
